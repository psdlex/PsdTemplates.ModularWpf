<Window
    x:Class="PsdTemplates.ModularWpf.Modules.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:main="clr-namespace:PsdTemplates.ModularWpf.Modules.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Main Window"
    Width="1024"
    Height="576"
    d:DataContext="{d:DesignInstance Type=main:MainViewModel}"
    Background="{StaticResource WhitePrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding NavigateToHomePageCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <ContentControl Content="{Binding CurrentModel}" />

</Window>

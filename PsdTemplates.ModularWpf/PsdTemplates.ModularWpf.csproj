<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ApplicationDefinition Include="Application\App.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
	  <PackageReference Include="PsdFramework.ModularWpf" Version="2.5.1" />
	  <PackageReference Include="PsdFramework.ModularWpf.ExceptionHandling" Version="1.0.0" />
	  <PackageReference Include="PsdFramework.ModularWpf.Logging" Version="1.1.0" />
	  <PackageReference Include="PsdUtilities.ApplicationModules" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="appsettings.Logging.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="appsettings.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<FilteredPages Include="Resources/**/*.xaml" Exclude="Resources/Manual/**/*.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Modules\Shared\Behaviors\" />
	  <Folder Include="Modules\Shared\Controls\" />
	  <Folder Include="Resources\Fonts\" />
	</ItemGroup>

	<Target Name="GenerateResourceDictionaries" BeforeTargets="BeforeCompile">
		<ItemGroup>

			<Lines Include="&lt;ResourceDictionary xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;" />
			<Lines Include="&lt;ResourceDictionary.MergedDictionaries&gt;" />
			<Lines Include="@(FilteredPages-&gt;'&lt;ResourceDictionary Source=&quot;pack://application:,,,/$(MSBuildProjectName);component/%(RelativeDir)%(Filename)%(Extension)&quot; /&gt;'-&gt;Replace('\','/'))" />
			<Lines Include="&lt;/ResourceDictionary.MergedDictionaries&gt;" />
			<Lines Include="&lt;/ResourceDictionary&gt;" />

		</ItemGroup>

		<WriteLinesToFile File="Metadata/AutoGenerated/MergedResources.g.xaml" Overwrite="true" Lines="@(Lines)" />

		<ItemGroup>
			<Page Include="Metadata/AutoGenerated/MergedResources.g.xaml" />
		</ItemGroup>

	</Target>

</Project>